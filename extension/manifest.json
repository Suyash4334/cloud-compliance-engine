{
  "manifest_version": 3,
  "name": "Azure Watchdog Live Tracer",
  "version": "1.0",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://portal.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.azure.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}